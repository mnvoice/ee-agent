{
  "profile_metadata": {
    "profile_version": "0.1-draft",
    "domain_id": "ee-agent",
    "status": "draft",
    "compatible_schema_version": "0.1-draft",
    "compatible_schema_file": "rule_schema_v0.1_draft.schema.json",
    "created_at": "2026-05-27",
    "source_notes": [
      "본 profile은 Rule Schema Artifact Revision Gate의 산출물 초안.",
      "predicate·check 카탈로그는 policy_change_rules.json v0.2 12 규칙에서 역추출한 초안 (실측 검증 없음).",
      "threshold 값 4종은 D-3 관찰 또는 초기 추측. 모두 status: proposal.",
      "본 파일은 schema 파일의 profile_contract.required_root_keys를 준수."
    ]
  },

  "domain_taxonomy": {
    "status_values": ["CLEAN", "NEEDS_REVIEW", "catalog", "GAP"],
    "status_movement_notes": "정의된 status 간 이동만 추적. v0.1 NEEDS_REVIEW 인스턴스는 v0.2에서 NEEDS_REVIEW 또는 catalog로 분기. catalog는 ITEM_POLICY 안에 위치하되 generation 대상 아님.",
    "category_enum": [
      "RECOVERABILITY",
      "AMBIGUITY",
      "ROUTING",
      "POLICY_RELAXATION",
      "DATA_OR_TOOL_DRIFT",
      "BROAD_KEYWORD",
      "DATA_DEBT",
      "TOOL_CHANGE",
      "SUBJECT_CHANGE"
    ],
    "category_enum_notes": "Verdict.category 값. ee-agent 도메인 한정 어휘. 다른 도메인은 별도 profile에서 재정의."
  },

  "predicate_library": [
    {
      "predicate_id": "status_movement",
      "description": "특정 status A에서 status B로 이동한 entry 수가 임계 이상인지 판정.",
      "args_schema": {
        "type": "object",
        "required": ["from", "to", "min_count"],
        "properties": {
          "from": {"type": "string"},
          "to": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}}
            ]
          },
          "min_count": {"type": "integer", "minimum": 1}
        }
      },
      "examples": [
        {"from": "CLEAN", "to": "GAP", "min_count": 1},
        {"from": "GAP", "to": ["CLEAN", "NEEDS_REVIEW"], "min_count": 1}
      ],
      "draft_status": "역추출 초안. 실측 검증 없음."
    },
    {
      "predicate_id": "delta_status_count",
      "description": "특정 status의 증감 방향과 최소 변동량 판정.",
      "args_schema": {
        "type": "object",
        "required": ["status", "direction"],
        "properties": {
          "status": {"type": "string"},
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "zero"]
          },
          "min_count": {"type": "integer", "minimum": 0}
        }
      },
      "examples": [
        {"status": "CLEAN", "direction": "positive", "min_count": 1},
        {"status": "GAP", "direction": "positive", "min_count": 1}
      ],
      "draft_status": "역추출 초안. 실측 검증 없음."
    },
    {
      "predicate_id": "item_concentration_pct",
      "description": "단일 item이 전체에서 차지하는 비율이 임계 이상인지 판정.",
      "args_schema": {
        "type": "object",
        "required": ["min_pct"],
        "properties": {
          "item": {"type": "string"},
          "min_pct": {"type": "number", "minimum": 0, "maximum": 100}
        }
      },
      "examples": [
        {"min_pct": 60}
      ],
      "draft_status": "역추출 초안. min_pct 60 값은 threshold proposal 참조."
    },
    {
      "predicate_id": "hash_changed",
      "description": "지정 대상의 hash 변경 여부 판정.",
      "args_schema": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {
            "type": "string",
            "enum": ["questions", "tool", "policy"]
          }
        }
      },
      "examples": [
        {"target": "questions"},
        {"target": "tool"}
      ],
      "draft_status": "역추출 초안. 실측 검증 없음."
    },
    {
      "predicate_id": "abs_delta_pct",
      "description": "절대 변동률이 지정 범위에 들어가는지 판정.",
      "args_schema": {
        "type": "object",
        "properties": {
          "min": {"type": "number", "minimum": 0},
          "max": {"type": "number", "minimum": 0},
          "scope": {"type": "string"}
        },
        "anyOf": [
          {"required": ["min"]},
          {"required": ["max"]}
        ]
      },
      "examples": [
        {"max": 5},
        {"min": 10}
      ],
      "draft_status": "역추출 초안. min·max 값은 threshold proposal 참조."
    },
    {
      "predicate_id": "zero_hit_items",
      "description": "0 hit item 수가 임계 이상인지 판정.",
      "args_schema": {
        "type": "object",
        "required": ["at_least"],
        "properties": {
          "at_least": {"type": "integer", "minimum": 1}
        }
      },
      "examples": [
        {"at_least": 1}
      ],
      "draft_status": "역추출 초안. 실측 검증 없음."
    },
    {
      "predicate_id": "item_changed",
      "description": "같은 entry에서 매칭 item이 before/after 사이에 달라졌는지 판정.",
      "args_schema": {
        "type": "object",
        "properties": {
          "same_status": {"type": "boolean"}
        }
      },
      "examples": [
        {"same_status": true}
      ],
      "draft_status": "역추출 초안. 실측 검증 없음."
    }
  ],

